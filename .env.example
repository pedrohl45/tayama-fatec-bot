DISCORD_TOKEN=seu_token_secreto_aqui
GUILD_ID=123456789012345678
DB_PATH=fatec_bot.db

# Sincronização de Slash Commands
# true  → sincroniza os comandos ao iniciar o bot (use na primeira vez ou após adicionar novos comandos)
# false → pula a sincronização (padrão em produção — evita rate limit do Discord)
SYNC_COMMANDS=false

# ID do canal de texto onde o bot enviará o lembrete matinal de aulas (07:00 BRT)
# Deixe em branco ou remova para desativar o lembrete
CANAL_AVISOS_ID=
